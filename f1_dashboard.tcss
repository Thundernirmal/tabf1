/* Tokyo Night theme (exact palette) */

Screen {
    background: transparent;
}
#title, #season {
    width: 100%;
    content-align: center middle;
}

#title {
    padding: 0 0 0 0;
    margin: 1 0 0 0;
    color: auto;
    text-style: bold;
}

#season {
    margin: 0 0 1 0;
    color: auto;
}

Header {
    background: transparent; /* black */
    color: auto;
    text-style: bold;
}

Footer {
    background: transparent; /* black */
    color: auto;
    height: 3;
}

#main {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    padding: 1 2;
    background: transparent; /* ensure no default black shows */
}

#drivers-panel, #constructors-panel {
    border: round;
    background: transparent;   /* black */
    width: 1fr;
    height: 1fr;
    padding: 1 1;
    margin: 0 1;
    overflow: hidden;
    border-title-align: center;
    border-subtitle-align: center;
}

#race-panel {
    border: round;
    background: transparent;
    width: 100%;
    height: 1fr;
    padding: 1 2;
    margin: 0 0 1 0;
    overflow: hidden;
    border-title-align: center;
    border-subtitle-align: center;
    border-title-color: auto;
}

#drivers-panel {
    border-title-color: auto;
}

#constructors-panel {
    border-title-color: auto;
}

/* Emphasize focused sections */
#drivers-panel:focus-within,
#constructors-panel:focus-within,
#race-panel:focus-within,
#detail-wrapper:focus-within {
    border: heavy;
    border-title-style: bold;
}

DataTable {
    height: 1fr;
    width: 100%;
    background: transparent;
    color: auto;
    border: none;
    overflow: hidden;
}

DataTable > .datatable--header {
    background: transparent;
    color: auto;
    text-style: bold;
}

/* Clear and accessible row selection */
DataTable > .datatable--cursor {
    background: transparent;
    text-style: reverse bold;
}

DataTable > .datatable--row {
    background: transparent; /* inherit terminal background */
    color: auto;
}

DataTable > .datatable--row:hover {
    background: transparent;
    text-style: reverse;
}

DataTable > .datatable--fixed {
    background: transparent;
}

DataTable > .datatable--hover {
    background: transparent; /* brightBlack */
}

/* Details modal styling */
#detail-wrapper {
    width: 90%;
    height: auto;
    background: transparent;
    border: round;
    padding: 1 2;
    align: center middle;
    content-align: center top;
}

#detail-title {
    color: auto;
    margin: 0 0 1 0;
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

#detail-table {
    height: auto;
    width: 100%;
    background: transparent;
    align: center middle;
    content-align: center top;
}
