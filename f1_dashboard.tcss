/* Enhanced F1 Dashboard - Tokyo Night Compatible with Clean Backgrounds */

/* Base styling */
Screen {
    background: transparent;
    color: auto;
}

/* Title and Season styling */
#title, #season {
    width: 100%;
    content-align: center middle;
}

#title {
    padding: 0 0 0 0;
    margin: 1 0 0 0;
    color: #7dcfff;
    text-style: bold;
    background: transparent;
    border: round #7aa2f7;
    height: auto;
}

#season {
    margin: 0 0 1 0;
    color: #e0af68;
    text-style: italic;
    background: transparent;
}

/* Header and Footer */
Header {
    background: transparent;
    color: auto;
    text-style: bold;
    border-bottom: wide #7aa2f7;
}

Footer {
    background: transparent;
    color: auto;
    height: 3;
    border-top: wide #7aa2f7;
}

/* Main container */
#main {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    padding: 1 2;
    background: transparent;
    border: none;
}

/* Panel styling with transparent backgrounds and colored borders */
#drivers-panel, #constructors-panel {
    background: transparent;
    width: 1fr;
    height: 1fr;
    padding: 1 1;
    margin: 0 1;
    overflow: hidden;
    border-title-align: center;
    border-subtitle-align: center;
    border-title-style: bold;
}

#drivers-panel {
    border-title-color: #7dcfff;
    border: round #7dcfff;
}

#constructors-panel {
    border-title-color: #bb9af7;
    border: round #bb9af7;
}

#race-panel {
    border: round #9ece6a;
    background: transparent;
    width: 100%;
    height: 1fr;
    padding: 1 2;
    margin: 0 0 1 0;
    overflow: hidden;
    border-title-align: center;
    border-subtitle-align: center;
    border-title-color: #9ece6a;
    border-title-style: bold;
}

/* Focus states with thicker borders only */
#drivers-panel:focus-within {
    border: heavy #7dcfff;
    border-title-style: bold;
}

#constructors-panel:focus-within {
    border: heavy #bb9af7;
    border-title-style: bold;
}

#race-panel:focus-within {
    border: heavy #9ece6a;
    border-title-style: bold;
}

#detail-wrapper:focus-within {
    border: heavy #7aa2f7;
}

/* Clean DataTable styling with transparent backgrounds */
DataTable {
    height: 1fr;
    width: 100%;
    background: transparent;
    color: auto;
    border: none;
    overflow: hidden;
}

DataTable > .datatable--header {
    background: transparent;
    color: #7dcfff;
    text-style: bold;
}

/* Clean row selection */
DataTable > .datatable--cursor {
    background: transparent;
    color: auto;
    text-style: reverse bold;
}

DataTable > .datatable--row {
    background: transparent;
    color: auto;
}

DataTable > .datatable--row:hover {
    background: transparent;
    text-style: reverse;
}

DataTable > .datatable--fixed {
    background: transparent;
    color: #e0af68;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: transparent;
}

/* Clean modal styling */
#detail-wrapper {
    width: 90%;
    height: auto;
    background: transparent;
    border: thick #7aa2f7;
    padding: 2 3;
    align: center middle;
    content-align: center top;
}

#detail-title {
    color: #7dcfff;
    margin: 0 0 2 0;
    text-style: bold;
    width: 100%;
    content-align: center middle;
    background: transparent;
    border: round #7aa2f7;
    padding: 1 2;
}

#detail-table {
    height: auto;
    width: 100%;
    background: transparent;
    align: center middle;
    content-align: center top;
    border: none;
}
